Dialogue: 0,0:00:03.03,0:00:06.37,Default,,0,0,0,,(IDEAPOCKET  出品)
Dialogue: 0,0:00:09.30,0:00:11.71,Default,,0,0,0,,(约会后  女友让我来她家)
Dialogue: 0,0:00:13.44,0:00:15.58,Default,,0,0,0,,请吧
Dialogue: 0,0:00:15.58,0:00:17.18,Default,,0,0,0,,久等了\N谢谢
Dialogue: 0,0:00:18.78,0:00:23.05,Default,,0,0,0,,久违的约会   好开心啊
Dialogue: 0,0:00:23.05,0:00:24.25,Default,,0,0,0,,是呢
Dialogue: 0,0:00:24.79,0:00:27.05,Default,,0,0,0,,对了
Dialogue: 0,0:00:27.05,0:00:28.79,Default,,0,0,0,,今天在我家睡吧
Dialogue: 0,0:00:28.79,0:00:31.99,Default,,0,0,0,,今天我的父母去旅行了   不在家
Dialogue: 0,0:00:31.99,0:00:33.86,Default,,0,0,0,,可以吧
Dialogue: 0,0:00:34.00,0:00:35.33,Default,,0,0,0,,好的
Dialogue: 0,0:00:35.33,0:00:36.53,Default,,0,0,0,,太好了
Dialogue: 0,0:00:40.94,0:00:41.60,Default,,0,0,0,,接吻
Dialogue: 0,0:00:41.74,0:00:43.20,Default,,0,0,0,,诶
Dialogue: 0,0:00:44.14,0:00:45.61,Default,,0,0,0,,接吻啊
Dialogue: 0,0:00:52.81,0:00:56.55,Default,,0,0,0,,哥哥来了啊    好久不见啊
Dialogue: 0,0:00:56.55,0:00:58.42,Default,,0,0,0,,好久不见
Dialogue: 0,0:00:58.55,0:01:02.56,Default,,0,0,0,,我要喝果汁\N好的
Dialogue: 0,0:01:02.56,0:01:04.16,Default,,0,0,0,,我去了哦
Dialogue: 0,0:01:47.67,0:01:50.20,Default,,0,0,0,,哥哥今天你们去哪里了
Dialogue: 0,0:02:02.08,0:02:03.95,Default,,0,0,0,,哥哥
Dialogue: 0,0:02:03.95,0:02:05.95,Default,,0,0,0,,你看什么呢
Dialogue: 0,0:02:05.95,0:02:09.16,Default,,0,0,0,,我没有看
Dialogue: 0,0:02:09.16,0:02:11.29,Default,,0,0,0,,好下流    真是的
Dialogue: 0,0:02:11.29,0:02:13.83,Default,,0,0,0,,等一下
Dialogue: 0,0:02:13.83,0:02:16.63,Default,,0,0,0,,不喝吗
Dialogue: 0,0:02:18.77,0:02:20.77,Default,,0,0,0,,怎么了
Dialogue: 0,0:02:20.77,0:02:22.10,Default,,0,0,0,,怎么了啊
Dialogue: 0,0:02:23.97,0:02:25.97,Default,,0,0,0,,那个    不知道啊
Dialogue: 0,0:02:32.91,0:02:40.92,Default,,0,0,0,,(枫哥    出演)
Dialogue: 0,0:03:50.46,0:03:58.87,Default,,0,0,0,,(女友的妹妹用美脚)\N(和若隐若现的内裤诱惑我上钩)
Dialogue: 0,0:04:24.23,0:04:26.76,Default,,0,0,0,,怎么了
Dialogue: 0,0:04:26.76,0:04:30.23,Default,,0,0,0,,今天好困啊
Dialogue: 0,0:04:31.03,0:04:33.83,Default,,0,0,0,,对不起啊    下次做吧
Dialogue: 0,0:04:39.44,0:04:42.64,Default,,0,0,0,,(最近在床上好冷淡啊)
Dialogue: 0,0:05:35.10,0:05:36.30,Default,,0,0,0,,哥哥
Dialogue: 0,0:05:36.30,0:05:37.77,Default,,0,0,0,,莫非你看了
Dialogue: 0,0:05:38.03,0:05:40.57,Default,,0,0,0,,(华莲生气了)
Dialogue: 0,0:05:40.57,0:05:43.90,Default,,0,0,0,,你说谁生气了
Dialogue: 0,0:05:45.77,0:05:48.98,Default,,0,0,0,,你觉得刚才偷看我    我生气了
Dialogue: 0,0:05:49.24,0:05:54.32,Default,,0,0,0,,我不介意哥哥看我
Dialogue: 0,0:05:56.05,0:05:58.45,Default,,0,0,0,,(不介意我看啊)
Dialogue: 0,0:05:58.45,0:05:59.65,Default,,0,0,0,,但是
Dialogue: 0,0:05:59.65,0:06:02.59,Default,,0,0,0,,要是被姐姐发现了\N你打算怎么办
Dialogue: 0,0:06:02.72,0:06:05.53,Default,,0,0,0,,姐姐很可怕的哦
Dialogue: 0,0:06:05.53,0:06:09.80,Default,,0,0,0,,莫非
Dialogue: 0,0:06:09.93,0:06:11.93,Default,,0,0,0,,哥哥今天没有跟姐姐做爱
Dialogue: 0,0:06:11.93,0:06:15.67,Default,,0,0,0,,平时我能听到声音的
Dialogue: 0,0:06:19.27,0:06:23.14,Default,,0,0,0,,看到我的内裤兴奋了吧
Dialogue: 0,0:06:24.48,0:06:27.01,Default,,0,0,0,,我跟姐姐说吧
Dialogue: 0,0:06:29.28,0:06:32.89,Default,,0,0,0,,哥哥好久没有做了吧
Dialogue: 0,0:06:34.49,0:06:35.82,Default,,0,0,0,,喂
Dialogue: 0,0:06:37.29,0:06:38.09,Default,,0,0,0,,看啊
Dialogue: 0,0:06:39.29,0:06:42.23,Default,,0,0,0,,硬了啊
Dialogue: 0,0:06:48.50,0:06:50.37,Default,,0,0,0,,喂
Dialogue: 0,0:06:50.37,0:06:53.04,Default,,0,0,0,,看到内裤兴奋了吧
Dialogue: 0,0:06:56.24,0:06:59.98,Default,,0,0,0,,不用说谎的
Dialogue: 0,0:06:59.98,0:07:04.39,Default,,0,0,0,,来吧
Dialogue: 0,0:07:16.53,0:07:17.33,Default,,0,0,0,,为什么啊
Dialogue: 0,0:07:17.46,0:07:19.73,Default,,0,0,0,,在忍着的吧
Dialogue: 0,0:07:19.73,0:07:22.54,Default,,0,0,0,,不会被发现的
Dialogue: 0,0:07:27.07,0:07:29.08,Default,,0,0,0,,不行吗
Dialogue: 0,0:07:32.95,0:07:35.75,Default,,0,0,0,,来吧
Dialogue: 0,0:07:37.35,0:07:38.55,Default,,0,0,0,,哥哥
Dialogue: 0,0:07:39.75,0:07:41.49,Default,,0,0,0,,哥哥
Dialogue: 0,0:07:42.56,0:07:45.89,Default,,0,0,0,,来吧
Dialogue: 0,0:07:46.96,0:07:51.50,Default,,0,0,0,,哥哥喜欢这样吧
Dialogue: 0,0:07:56.30,0:07:59.91,Default,,0,0,0,,脸变红了哦    哥哥
Dialogue: 0,0:08:15.12,0:08:17.12,Default,,0,0,0,,怎么样    兴奋了吗
Dialogue: 0,0:08:27.94,0:08:30.20,Default,,0,0,0,,哥哥喜欢内裤吗
Dialogue: 0,0:08:33.94,0:08:39.01,Default,,0,0,0,,来吧
Dialogue: 0,0:08:47.69,0:08:49.82,Default,,0,0,0,,哥哥硬了啊
Dialogue: 0,0:08:52.36,0:08:57.03,Default,,0,0,0,,哥哥变硬了
Dialogue: 0,0:09:01.70,0:09:04.91,Default,,0,0,0,,越来越硬了
Dialogue: 0,0:09:06.24,0:09:11.71,Default,,0,0,0,,哥哥喜欢脚吗
Dialogue: 0,0:09:19.45,0:09:22.92,Default,,0,0,0,,哥哥的脸好红啊
Dialogue: 0,0:09:33.87,0:09:35.74,Default,,0,0,0,,哥哥多久没有做爱了
Dialogue: 0,0:09:41.21,0:09:44.01,Default,,0,0,0,,我来满足你吧
Dialogue: 0,0:09:47.75,0:09:50.55,Default,,0,0,0,,看到我的内裤兴奋了吧
Dialogue: 0,0:09:54.96,0:09:57.76,Default,,0,0,0,,做爱吧
Dialogue: 0,0:10:01.36,0:10:04.97,Default,,0,0,0,,看着哦
Dialogue: 0,0:10:04.97,0:10:06.83,Default,,0,0,0,,我看看
Dialogue: 0,0:10:10.84,0:10:13.24,Default,,0,0,0,,快点
Dialogue: 0,0:10:29.39,0:10:35.66,Default,,0,0,0,,哥哥的肉棒硬了
Dialogue: 0,0:10:37.13,0:10:39.67,Default,,0,0,0,,看到我的内裤兴奋了吗
Dialogue: 0,0:10:40.87,0:10:44.34,Default,,0,0,0,,好开心啊
Dialogue: 0,0:10:50.08,0:10:53.81,Default,,0,0,0,,我一直在意哥哥的肉棒
Dialogue: 0,0:10:59.55,0:11:03.16,Default,,0,0,0,,哥哥喜欢脚的话我就给你哦
Dialogue: 0,0:11:09.70,0:11:13.17,Default,,0,0,0,,哥哥舒服吗
Dialogue: 0,0:11:25.71,0:11:27.45,Default,,0,0,0,,没事的    不会跟姐姐说的
Dialogue: 0,0:11:34.25,0:11:36.92,Default,,0,0,0,,哥哥的肉棒舒服吧
Dialogue: 0,0:11:36.92,0:11:41.06,Default,,0,0,0,,那就可以了吧
Dialogue: 0,0:11:43.33,0:11:46.27,Default,,0,0,0,,继续舒服吧
Dialogue: 0,0:11:53.34,0:11:57.21,Default,,0,0,0,,很想看我吧
Dialogue: 0,0:12:25.37,0:12:26.84,Default,,0,0,0,,好厉害    湿湿的
Dialogue: 0,0:12:29.24,0:12:31.91,Default,,0,0,0,,怎么样    舒服吗
Dialogue: 0,0:12:38.19,0:12:41.66,Default,,0,0,0,,还没有摸呢    就这么硬了
Dialogue: 0,0:12:51.40,0:12:53.93,Default,,0,0,0,,哥哥真是变态啊
Dialogue: 0,0:13:07.55,0:13:09.95,Default,,0,0,0,,姐姐醒了的话怎么办
Dialogue: 0,0:13:11.29,0:13:15.69,Default,,0,0,0,,没事的    不会来的
Dialogue: 0,0:13:18.76,0:13:20.36,Default,,0,0,0,,舒服吗
Dialogue: 0,0:13:29.57,0:13:32.77,Default,,0,0,0,,我用手给你摸
Dialogue: 0,0:13:39.71,0:13:43.58,Default,,0,0,0,,哥哥喜欢我怎么摸
Dialogue: 0,0:13:45.45,0:13:47.72,Default,,0,0,0,,这样吗
Dialogue: 0,0:14:07.47,0:14:11.35,Default,,0,0,0,,脸好红啊
Dialogue: 0,0:14:12.15,0:14:15.08,Default,,0,0,0,,舒服吗
Dialogue: 0,0:14:26.43,0:14:29.50,Default,,0,0,0,,哥哥脱了裤子吧
Dialogue: 0,0:14:47.11,0:14:50.58,Default,,0,0,0,,哥哥摸我的腿吧    喜欢吧
Dialogue: 0,0:14:58.99,0:15:02.73,Default,,0,0,0,,哥哥喜欢我还是姐姐
Dialogue: 0,0:15:06.47,0:15:10.20,Default,,0,0,0,,哪个
Dialogue: 0,0:15:25.02,0:15:27.69,Default,,0,0,0,,哥哥舒服吗
Dialogue: 0,0:15:29.56,0:15:31.83,Default,,0,0,0,,舒服吗
Dialogue: 0,0:15:34.09,0:15:37.96,Default,,0,0,0,,我一直想要这样的
Dialogue: 0,0:15:54.78,0:15:57.98,Default,,0,0,0,,哥哥喜欢这样的吧
Dialogue: 0,0:16:04.26,0:16:07.73,Default,,0,0,0,,一起摸乳头怎么样
Dialogue: 0,0:16:12.13,0:16:14.00,Default,,0,0,0,,舒服吗
Dialogue: 0,0:16:27.21,0:16:28.68,Default,,0,0,0,,舒服吗哥哥
Dialogue: 0,0:16:30.82,0:16:32.29,Default,,0,0,0,,乳头好挺了
Dialogue: 0,0:16:40.56,0:16:43.10,Default,,0,0,0,,哥哥的肉棒好硬啊
Dialogue: 0,0:16:58.31,0:17:00.71,Default,,0,0,0,,让我看看你舒服的样子吧
Dialogue: 0,0:17:20.07,0:17:22.20,Default,,0,0,0,,哥哥的肉棒好大啊
Dialogue: 0,0:17:25.14,0:17:26.87,Default,,0,0,0,,哥哥舒服吗
Dialogue: 0,0:17:29.94,0:17:33.81,Default,,0,0,0,,给你夹住哦
Dialogue: 0,0:17:37.02,0:17:41.15,Default,,0,0,0,,怎么样    舒服吗
Dialogue: 0,0:17:41.29,0:17:46.09,Default,,0,0,0,,这样夹住又同时摸龟头怎么样
Dialogue: 0,0:17:46.23,0:17:48.50,Default,,0,0,0,,喜欢吗
Dialogue: 0,0:18:11.05,0:18:14.52,Default,,0,0,0,,可以射的哦
Dialogue: 0,0:18:22.80,0:18:25.60,Default,,0,0,0,,可以摸我的腿哦
Dialogue: 0,0:18:49.62,0:18:51.22,Default,,0,0,0,,舒服吗
Dialogue: 0,0:18:52.69,0:18:57.76,Default,,0,0,0,,哥哥舒服吗
Dialogue: 0,0:18:59.37,0:19:04.17,Default,,0,0,0,,让我看看你舒服的样子吧
Dialogue: 0,0:19:10.44,0:19:13.25,Default,,0,0,0,,好硬啊
Dialogue: 0,0:19:22.32,0:19:25.53,Default,,0,0,0,,湿湿的
Dialogue: 0,0:19:29.80,0:19:33.27,Default,,0,0,0,,舒服吗
Dialogue: 0,0:19:36.74,0:19:39.14,Default,,0,0,0,,要射了吗
Dialogue: 0,0:19:39.27,0:19:41.14,Default,,0,0,0,,可以的哦
Dialogue: 0,0:19:41.14,0:19:43.41,Default,,0,0,0,,射吧
Dialogue: 0,0:19:52.75,0:19:56.36,Default,,0,0,0,,舒服了吗
Dialogue: 0,0:19:57.82,0:20:00.89,Default,,0,0,0,,好厉害
Dialogue: 0,0:20:01.03,0:20:03.83,Default,,0,0,0,,好多啊
Dialogue: 0,0:20:05.30,0:20:08.10,Default,,0,0,0,,做到最后吧
Dialogue: 0,0:20:22.12,0:20:25.72,Default,,0,0,0,,(昨晚做了不该做的事情啊)
Dialogue: 0,0:20:30.39,0:20:33.59,Default,,0,0,0,,姐姐你们什么时候交往的
Dialogue: 0,0:20:33.86,0:20:36.80,Default,,0,0,0,,什么时候呢
Dialogue: 0,0:20:36.80,0:20:40.00,Default,,0,0,0,,一年前吧
Dialogue: 0,0:20:41.47,0:20:44.54,Default,,0,0,0,,好长啊\N是吗
Dialogue: 0,0:20:44.67,0:20:52.41,Default,,0,0,0,,我们是在职场上认识的\N是吗
Dialogue: 0,0:20:53.75,0:20:57.62,Default,,0,0,0,,一开始的时候  都不跟我说的
Dialogue: 0,0:20:57.62,0:21:01.62,Default,,0,0,0,,我在想   这个人怎么都不说话啊
Dialogue: 0,0:21:01.62,0:21:04.82,Default,,0,0,0,,然后慢慢的  关系就好了
Dialogue: 0,0:21:06.16,0:21:08.56,Default,,0,0,0,,你呢
Dialogue: 0,0:21:08.70,0:21:10.96,Default,,0,0,0,,什么\N没有男友吗
Dialogue: 0,0:21:10.96,0:21:11.63,Default,,0,0,0,,没有的
Dialogue: 0,0:21:12.03,0:21:12.97,Default,,0,0,0,,没有吗
Dialogue: 0,0:21:12.97,0:21:16.04,Default,,0,0,0,,好可惜啊
Dialogue: 0,0:21:16.04,0:21:18.57,Default,,0,0,0,,明明这么可爱
Dialogue: 0,0:21:18.57,0:21:19.77,Default,,0,0,0,,真的吗
Dialogue: 0,0:21:19.77,0:21:22.84,Default,,0,0,0,,男人真没有眼光啊
Dialogue: 0,0:21:22.84,0:21:24.71,Default,,0,0,0,,你也这么觉得吧
Dialogue: 0,0:21:24.71,0:21:26.85,Default,,0,0,0,,我妹妹很可爱
Dialogue: 0,0:21:26.85,0:21:30.58,Default,,0,0,0,,你这么觉得吗
Dialogue: 0,0:21:30.85,0:21:31.92,Default,,0,0,0,,一定是这么想的
Dialogue: 0,0:21:34.32,0:21:38.86,Default,,0,0,0,,工作之外的喝酒    真的好棒啊
Dialogue: 0,0:21:45.80,0:21:47.00,Default,,0,0,0,,姐姐喝多了吧
Dialogue: 0,0:21:48.07,0:21:51.00,Default,,0,0,0,,没事
Dialogue: 0,0:21:51.14,0:21:53.94,Default,,0,0,0,,工作好辛苦啊
Dialogue: 0,0:21:55.01,0:21:57.81,Default,,0,0,0,,那个上司真的好烦
Dialogue: 0,0:21:57.81,0:21:59.41,Default,,0,0,0,,你见过的吧
Dialogue: 0,0:21:59.41,0:22:03.82,Default,,0,0,0,,真是好烦啊
Dialogue: 0,0:22:04.88,0:22:06.49,Default,,0,0,0,,是什么样的
Dialogue: 0,0:22:06.62,0:22:10.22,Default,,0,0,0,,全部都让人烦
Dialogue: 0,0:22:10.36,0:22:13.03,Default,,0,0,0,,我明明这么努力的工作
Dialogue: 0,0:22:14.49,0:22:16.90,Default,,0,0,0,,真的好气人啊
Dialogue: 0,0:22:20.37,0:22:23.70,Default,,0,0,0,,喝多了吧
Dialogue: 0,0:22:27.04,0:22:30.51,Default,,0,0,0,,真是的
Dialogue: 0,0:22:32.11,0:22:35.58,Default,,0,0,0,,最近就是这样
Dialogue: 0,0:22:35.72,0:22:39.85,Default,,0,0,0,,喝多了吧
Dialogue: 0,0:22:39.85,0:22:48.13,Default,,0,0,0,,要是你是那个样子就分手\N男人好严格啊
Dialogue: 0,0:22:56.00,0:22:56.80,Default,,0,0,0,,姐姐
Dialogue: 0,0:23:02.28,0:23:04.54,Default,,0,0,0,,姐姐去床上吧    不然会感冒的
Dialogue: 0,0:23:04.68,0:23:06.55,Default,,0,0,0,,喂
Dialogue: 0,0:23:07.48,0:23:09.62,Default,,0,0,0,,姐姐
Dialogue: 0,0:23:13.09,0:23:14.02,Default,,0,0,0,,睡着了
Dialogue: 0,0:23:18.83,0:23:20.69,Default,,0,0,0,,过来吧
Dialogue: 0,0:23:20.83,0:23:23.90,Default,,0,0,0,,过来这边吧
Dialogue: 0,0:23:29.50,0:23:30.30,Default,,0,0,0,,喂
Dialogue: 0,0:23:30.30,0:23:32.57,Default,,0,0,0,,姐姐睡着了
Dialogue: 0,0:23:32.71,0:23:35.51,Default,,0,0,0,,继续昨天的吧
Dialogue: 0,0:23:39.51,0:23:43.12,Default,,0,0,0,,姐姐喝醉了    不会醒的
Dialogue: 0,0:23:46.72,0:23:49.39,Default,,0,0,0,,讨厌我吗
Dialogue: 0,0:23:49.52,0:23:51.66,Default,,0,0,0,,可以吧
Dialogue: 0,0:23:51.66,0:23:52.73,Default,,0,0,0,,喂
Dialogue: 0,0:24:08.07,0:24:09.68,Default,,0,0,0,,因为
Dialogue: 0,0:24:09.81,0:24:13.01,Default,,0,0,0,,姐姐很忙    没有跟你做爱吧
Dialogue: 0,0:24:15.28,0:24:18.62,Default,,0,0,0,,我来满足你哦
Dialogue: 0,0:24:18.75,0:24:22.76,Default,,0,0,0,,来吧
Dialogue: 0,0:24:23.82,0:24:26.89,Default,,0,0,0,,哥哥变大了啊
Dialogue: 0,0:24:28.09,0:24:29.83,Default,,0,0,0,,来吧
