Dialogue: 0,0:01:46.49,0:01:54.63,Default,,0,0,0,,京都不倫妻
Dialogue: 0,0:01:54.63,0:01:59.57,Default,,0,0,0,,明日花 晶
Dialogue: 0,0:04:02.53,0:04:06.46,Default,,0,0,0,,常來這嗎
Dialogue: 0,0:04:06.46,0:04:11.43,Default,,0,0,0,,沒有
Dialogue: 0,0:04:11.44,0:04:15.91,Default,,0,0,0,,為什麼來這裡
Dialogue: 0,0:04:15.91,0:04:18.64,Default,,0,0,0,,想來看看
Dialogue: 0,0:04:18.68,0:04:26.22,Default,,0,0,0,,結婚了嗎
Dialogue: 0,0:04:26.22,0:04:31.79,Default,,0,0,0,,是\N是嗎
Dialogue: 0,0:04:36.83,0:04:40.53,Default,,0,0,0,,在這晃晃吧\N好
Dialogue: 0,0:04:42.00,0:04:45.80,Default,,0,0,0,,這一帶
Dialogue: 0,0:04:45.80,0:04:54.64,Default,,0,0,0,,拖鞋很有名 那個呢
Dialogue: 0,0:04:57.41,0:04:59.82,Default,,0,0,0,,沒關係啊
Dialogue: 0,0:05:00.58,0:05:07.12,Default,,0,0,0,,好香的香味
Dialogue: 0,0:05:07.12,0:05:10.63,Default,,0,0,0,,好好吃的樣子\N點這個吧
Dialogue: 0,0:05:11.23,0:05:15.40,Default,,0,0,0,,這什麼好大喔
Dialogue: 0,0:05:17.97,0:05:22.34,Default,,0,0,0,,大嗎\N好棒
Dialogue: 0,0:05:22.34,0:05:26.98,Default,,0,0,0,,起士和煙燻的
Dialogue: 0,0:05:26.98,0:05:29.48,Default,,0,0,0,,那拜託了
Dialogue: 0,0:05:29.51,0:05:34.65,Default,,0,0,0,,這個呢\N摸摸看
Dialogue: 0,0:05:41.79,0:05:45.19,Default,,0,0,0,,有味道嗎
Dialogue: 0,0:05:45.23,0:05:49.73,Default,,0,0,0,,這是真的嗎\N假的?
Dialogue: 0,0:05:50.80,0:05:56.91,Default,,0,0,0,,好棒
Dialogue: 0,0:05:56.91,0:06:00.88,Default,,0,0,0,,像真的一樣
Dialogue: 0,0:06:01.91,0:06:05.55,Default,,0,0,0,,好香喔
Dialogue: 0,0:06:05.65,0:06:08.55,Default,,0,0,0,,好喔
Dialogue: 0,0:06:08.55,0:06:15.69,Default,,0,0,0,,好有趣的形狀喔\N起士
Dialogue: 0,0:06:23.23,0:06:25.94,Default,,0,0,0,,好好吃
Dialogue: 0,0:06:25.97,0:06:31.54,Default,,0,0,0,,有胡椒味\N肚子餓嗎
Dialogue: 0,0:06:31.54,0:06:34.01,Default,,0,0,0,,太好了
Dialogue: 0,0:06:34.11,0:06:40.08,Default,,0,0,0,,四處看看吧  如何
Dialogue: 0,0:06:40.08,0:06:46.62,Default,,0,0,0,,剛剛有神社吧  去那邊吧
Dialogue: 0,0:06:46.62,0:06:49.66,Default,,0,0,0,,走吧
Dialogue: 0,0:06:54.70,0:06:58.43,Default,,0,0,0,,要面紙嗎
Dialogue: 0,0:07:02.74,0:07:08.18,Default,,0,0,0,,在幹嘛\N怎麼辦
Dialogue: 0,0:07:08.18,0:07:15.32,Default,,0,0,0,,掉了\N騙人 會這樣嗎
Dialogue: 0,0:07:15.32,0:07:20.56,Default,,0,0,0,,今天有時間嗎\N可以閒晃
Dialogue: 0,0:07:20.56,0:07:23.69,Default,,0,0,0,,何時回去\N明天
Dialogue: 0,0:07:23.69,0:07:30.10,Default,,0,0,0,,明天啊\N還沒決定
Dialogue: 0,0:07:31.37,0:07:39.91,Default,,0,0,0,,老公不擔心嗎\N如何呢
Dialogue: 0,0:07:42.91,0:07:47.65,Default,,0,0,0,,那找個理由
Dialogue: 0,0:07:47.65,0:07:53.19,Default,,0,0,0,,拜託了\N知道怎麼到神社嗎
Dialogue: 0,0:07:57.39,0:08:03.83,Default,,0,0,0,,這邊好漂亮 不覺得啊
Dialogue: 0,0:08:04.50,0:08:06.14,Default,,0,0,0,,要走了
Dialogue: 0,0:08:06.17,0:08:08.47,Default,,0,0,0,,慘了\N好棒喔
Dialogue: 0,0:08:08.47,0:08:13.31,Default,,0,0,0,,好開心\N太好了
Dialogue: 0,0:08:14.54,0:08:21.48,Default,,0,0,0,,小心 好開心
Dialogue: 0,0:08:21.48,0:08:28.69,Default,,0,0,0,,慘了慘了 好開心\N開心吧
Dialogue: 0,0:08:31.46,0:08:36.67,Default,,0,0,0,,我從東京來
Dialogue: 0,0:08:36.70,0:08:39.67,Default,,0,0,0,,屁股好熱喔
Dialogue: 0,0:08:39.67,0:08:44.01,Default,,0,0,0,,我一直握著
Dialogue: 0,0:08:44.71,0:08:47.41,Default,,0,0,0,,這樣吃東西真奢侈耶
Dialogue: 0,0:08:47.44,0:08:58.42,Default,,0,0,0,,好奢侈的可樂餅
Dialogue: 0,0:09:02.53,0:09:05.93,Default,,0,0,0,,好吃\N好吃嗎
Dialogue: 0,0:09:05.93,0:09:12.17,Default,,0,0,0,,有點軟但好吃
Dialogue: 0,0:09:12.20,0:09:14.04,Default,,0,0,0,,好開心
Dialogue: 0,0:09:14.04,0:09:17.27,Default,,0,0,0,,這一台多少\N200元
Dialogue: 0,0:09:17.31,0:09:18.34,Default,,0,0,0,,怎麼知道\N猜對了嗎
Dialogue: 0,0:09:18.34,0:09:21.81,Default,,0,0,0,,猜對了啊\N好棒
Dialogue: 0,0:09:21.81,0:09:25.41,Default,,0,0,0,,怎麼知道\N好開心
Dialogue: 0,0:09:25.42,0:09:28.38,Default,,0,0,0,,没有引擎卻要200萬
Dialogue: 0,0:09:28.39,0:09:32.45,Default,,0,0,0,,真的耶 手工的吧\N是啊
Dialogue: 0,0:09:32.76,0:09:38.16,Default,,0,0,0,,好開朗喔\N其是
Dialogue: 0,0:09:39.53,0:09:44.37,Default,,0,0,0,,跟印象不同\N吃光了
Dialogue: 0,0:09:44.37,0:09:50.37,Default,,0,0,0,,結婚多久\N第4年
Dialogue: 0,0:09:52.61,0:10:01.02,Default,,0,0,0,,老公呢\N老公?現在
Dialogue: 0,0:10:02.02,0:10:06.19,Default,,0,0,0,,工作中\N打電話了嗎
Dialogue: 0,0:10:06.19,0:10:14.73,Default,,0,0,0,,傳簡訊了\N真的?好嗎
Dialogue: 0,0:10:23.37,0:10:26.71,Default,,0,0,0,,怎麼吵架呢  猜猜看吧
Dialogue: 0,0:10:26.74,0:10:30.51,Default,,0,0,0,,老公偷吃
Dialogue: 0,0:10:30.51,0:10:35.05,Default,,0,0,0,,是嗎\N對
Dialogue: 0,0:10:35.79,0:10:39.86,Default,,0,0,0,,是喔
Dialogue: 0,0:10:40.72,0:10:49.63,Default,,0,0,0,,很嚴重吧  唦架嗎\N有吵架
Dialogue: 0,0:10:49.63,0:10:57.07,Default,,0,0,0,,不止一點吧  都到這裡來了
Dialogue: 0,0:10:57.07,0:11:02.64,Default,,0,0,0,,怎麼知道的
Dialogue: 0,0:11:04.31,0:11:08.05,Default,,0,0,0,,看手機
Dialogue: 0,0:11:13.16,0:11:16.66,Default,,0,0,0,,男人真诈
Dialogue: 0,0:11:16.69,0:11:19.70,Default,,0,0,0,,抱歉喔  問這個
Dialogue: 0,0:11:19.70,0:11:21.86,Default,,0,0,0,,好開心\N開心吧
Dialogue: 0,0:11:21.90,0:11:25.57,Default,,0,0,0,,好開心喔
Dialogue: 0,0:11:29.27,0:11:33.51,Default,,0,0,0,,怎麼辦 可以的話
Dialogue: 0,0:11:33.51,0:11:38.51,Default,,0,0,0,,明天也在我跟妳聯絡吧
Dialogue: 0,0:11:38.52,0:11:41.22,Default,,0,0,0,,換個地方吧
Dialogue: 0,0:11:47.76,0:11:53.50,Default,,0,0,0,,明天還沒要回去吧
Dialogue: 0,0:11:53.50,0:12:00.14,Default,,0,0,0,,大概\N可以的話輸入我的號碼吧
Dialogue: 0,0:12:00.14,0:12:06.64,Default,,0,0,0,,隨時可以打來
Dialogue: 0,0:12:06.68,0:12:11.35,Default,,0,0,0,,不打的話就算了
Dialogue: 0,0:12:11.35,0:12:12.82,Default,,0,0,0,,好
Dialogue: 0,0:12:13.42,0:12:16.39,Default,,0,0,0,,走吧
Dialogue: 0,0:12:23.23,0:12:29.90,Default,,0,0,0,,找有趣的事情吧  好了嗎
Dialogue: 0,0:12:29.90,0:12:33.34,Default,,0,0,0,,謝謝
Dialogue: 0,0:23:15.14,0:23:18.28,Default,,0,0,0,,是
Dialogue: 0,0:23:24.02,0:23:26.79,Default,,0,0,0,,中午的
Dialogue: 0,0:23:26.79,0:23:30.59,Default,,0,0,0,,我記得
Dialogue: 0,0:23:34.16,0:23:40.77,Default,,0,0,0,,現在剛洗完澡
Dialogue: 0,0:23:41.44,0:23:46.21,Default,,0,0,0,,沒事啊
Dialogue: 0,0:23:57.25,0:24:00.62,Default,,0,0,0,,現在嗎
Dialogue: 0,0:24:08.86,0:24:14.44,Default,,0,0,0,,好 那我等你
Dialogue: 0,0:24:15.47,0:24:19.97,Default,,0,0,0,,用簡訊 好
Dialogue: 0,0:24:20.01,0:24:26.18,Default,,0,0,0,,那用簡訊傳地址
Dialogue: 0,0:24:53.98,0:24:56.88,Default,,0,0,0,,是
Dialogue: 0,0:27:36.77,0:27:39.61,Default,,0,0,0,,舒服嗎
Dialogue: 0,0:29:14.74,0:29:17.07,Default,,0,0,0,,再來
Dialogue: 0,0:29:48.24,0:29:50.57,Default,,0,0,0,,不要緊嗎
Dialogue: 0,0:32:07.11,0:32:09.61,Default,,0,0,0,,好舒服
Dialogue: 0,0:35:10.79,0:35:13.93,Default,,0,0,0,,好舒服
Dialogue: 0,0:35:42.69,0:35:45.89,Default,,0,0,0,,到上面
Dialogue: 0,0:44:15.44,0:44:19.71,Default,,0,0,0,,好舒服
Dialogue: 0,0:46:23.87,0:46:27.17,Default,,0,0,0,,好舒服
Dialogue: 0,0:47:20.12,0:47:23.39,Default,,0,0,0,,好舒服
Dialogue: 0,0:49:18.01,0:49:20.64,Default,,0,0,0,,好舒服
Dialogue: 0,0:49:48.47,0:49:51.94,Default,,0,0,0,,舒服嗎
Dialogue: 0,0:51:35.24,0:51:38.48,Default,,0,0,0,,射了
Dialogue: 0,0:54:41.50,0:54:44.86,Default,,0,0,0,,喂
Dialogue: 0,0:54:44.90,0:54:48.40,Default,,0,0,0,,現在可以嗎
Dialogue: 0,0:54:51.77,0:54:57.54,Default,,0,0,0,,是 對
Dialogue: 0,0:55:00.38,0:55:05.72,Default,,0,0,0,,可以選類型嗎
Dialogue: 0,0:55:08.86,0:55:13.66,Default,,0,0,0,,想要有男人味的
Dialogue: 0,0:55:16.00,0:55:20.37,Default,,0,0,0,,是 沒關係
Dialogue: 0,0:55:20.40,0:55:24.10,Default,,0,0,0,,是
Dialogue: 0,0:55:24.41,0:55:30.18,Default,,0,0,0,,是 知道了 拜託了
Dialogue: 0,1:09:31.45,1:09:34.99,Default,,0,0,0,,好舒服
Dialogue: 0,1:11:51.56,1:11:54.96,Default,,0,0,0,,好粗
Dialogue: 0,1:19:22.07,1:19:24.61,Default,,0,0,0,,看的到嗎
Dialogue: 0,1:19:24.64,1:19:26.95,Default,,0,0,0,,好棒
Dialogue: 0,1:24:17.67,1:24:20.44,Default,,0,0,0,,好棒
Dialogue: 0,1:29:45.53,1:29:48.47,Default,,0,0,0,,去了
